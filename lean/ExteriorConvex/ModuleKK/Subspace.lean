import Mathlib
import ExteriorConvex.ModuleKK.LexShadow

open Finset Module
open scoped FinsetFamily

namespace ExteriorConvex
namespace ModuleKK

/-! ### The model: monomials, vectors, the lexF order -/

/-- The monomials `e_σ gᵢ` of `F`, as pairs `(i, σ)`. -/
abbrev Mon (r n : ℕ) := Fin r × Finset (Fin n)

/-- The model of `F = ⊕ᵢ E gᵢ` as a `K`-vector space: coefficient functions on the monomials. -/
abbrev FMod (K : Type*) (r n : ℕ) := Mon r n → K

section Order
variable {r n : ℕ}

/-- `m >_{lexF} m'` (the paper's position-over-term order, after Amata–Crupi): `m = u gᵢ`,
`m' = v gₗ` with `i < l`, or `i = l` and `u >_lex v` (`LexLT u v`). -/
def LexFGT (m m' : Mon r n) : Prop := m.1 < m'.1 ∨ (m.1 = m'.1 ∧ LexLT m.2 m'.2)

/-- Sort key for lexF: `m >_{lexF} m'` iff `lexFKey m < lexFKey m'` (`lexFGT_iff_key`). -/
def lexFKey (m : Mon r n) : Fin r ×ₗ Colex (Finset (Fin n)) := toLex (m.1, toColex (phi m.2))

lemma lexFGT_iff_key {m m' : Mon r n} : LexFGT m m' ↔ lexFKey m < lexFKey m' := by
  rw [lexFKey, lexFKey, Prod.Lex.toLex_lt_toLex, LexFGT, lexLT_iff_colex]

lemma lexFKey_injective : Function.Injective (lexFKey (r := r) (n := n)) := by
  intro m m' h
  simp only [lexFKey, toLex_inj, Prod.mk.injEq] at h
  exact Prod.ext h.1 (phi_injective (toColex.injective h.2))

/-- `lexF` is compatible with multiplication by `e_x`: adding `x` to two sets avoiding it does not
change their symmetric difference. (Only `x ∉ σ` is needed for this direction.) -/
lemma lexLT_insert {x : Fin n} {σ τ : Finset (Fin n)} (hσ : x ∉ σ)
    (h : LexLT σ τ) : LexLT (insert x σ) (insert x τ) := by
  obtain ⟨a, ha, hat, hmin⟩ := h
  refine ⟨a, mem_insert_of_mem ha, ?_, ?_⟩
  · rw [mem_insert, not_or]; exact ⟨fun e => hσ (e ▸ ha), hat⟩
  · intro b hb hb'
    rw [mem_insert, not_or] at hb'
    rw [mem_insert] at hb
    exact hmin b (hb.resolve_left hb'.1) hb'.2

end Order

/-! ### Leading monomials (target 1) -/

section Lead
variable {K : Type*} [Field K] {r n : ℕ}

/-- `IsLead v m`: `m` is the lexF-leading monomial `in(v)` of `v`, i.e. `m` lies in the support
of `v` and is lexF-larger than every other monomial of the support. -/
def IsLead (v : FMod K r n) (m : Mon r n) : Prop :=
  v m ≠ 0 ∧ ∀ m', v m' ≠ 0 → m' ≠ m → LexFGT m m'

lemma IsLead.key_le {v : FMod K r n} {m : Mon r n} (h : IsLead v m) {m' : Mon r n}
    (hm' : v m' ≠ 0) : lexFKey m ≤ lexFKey m' := by
  by_cases e : m' = m
  · rw [e]
  · exact (lexFGT_iff_key.mp (h.2 m' hm' e)).le

lemma isLead_of_key {v : FMod K r n} {m : Mon r n} (hm : v m ≠ 0)
    (h : ∀ m', v m' ≠ 0 → lexFKey m ≤ lexFKey m') : IsLead v m :=
  ⟨hm, fun m' hm' hne => lexFGT_iff_key.mpr
    (lt_of_le_of_ne (h m' hm') fun e => hne (lexFKey_injective e).symm)⟩

lemma IsLead.ne_zero {v : FMod K r n} {m : Mon r n} (h : IsLead v m) : v ≠ 0 :=
  fun e => h.1 (by rw [e]; rfl)

lemma IsLead.unique {v : FMod K r n} {m m' : Mon r n} (h : IsLead v m) (h' : IsLead v m') :
    m = m' :=
  lexFKey_injective (le_antisymm (h.key_le h'.1) (h'.key_le h.1))

/-- Every non-zero vector has a lexF-leading monomial. -/
lemma exists_isLead {v : FMod K r n} (hv : v ≠ 0) : ∃ m, IsLead v m := by
  classical
  obtain ⟨m₀, hm₀⟩ := Function.ne_iff.mp hv
  have hs : (univ.filter fun m => v m ≠ 0).Nonempty := ⟨m₀, by simpa using hm₀⟩
  obtain ⟨m, hm, hmin⟩ := exists_min_image _ lexFKey hs
  exact ⟨m, isLead_of_key (by simpa using hm) fun m' hm' => hmin m' (by simpa using hm')⟩

/-- `in(v)`: the lexF-largest monomial in the support of a non-zero `v`. -/
noncomputable def lead (v : FMod K r n) (hv : v ≠ 0) : Mon r n := (exists_isLead hv).choose

lemma isLead_lead {v : FMod K r n} (hv : v ≠ 0) : IsLead v (lead v hv) :=
  (exists_isLead hv).choose_spec

lemma isLead_iff_lead_eq {v : FMod K r n} {m : Mon r n} :
    IsLead v m ↔ ∃ hv : v ≠ 0, lead v hv = m :=
  ⟨fun h => ⟨h.ne_zero, (isLead_lead h.ne_zero).unique h⟩, fun ⟨hv, e⟩ => e ▸ isLead_lead hv⟩

open Classical in
/-- `in(W) = {in(w) : 0 ≠ w ∈ W}`, the leading monomials of the non-zero vectors of `W`. -/
noncomputable def inn (W : Submodule K (FMod K r n)) : Finset (Mon r n) :=
  univ.filter fun m => ∃ w ∈ W, IsLead w m

lemma mem_inn {W : Submodule K (FMod K r n)} {m : Mon r n} :
    m ∈ inn W ↔ ∃ w ∈ W, IsLead w m := by
  simp [inn]

lemma mem_inn_iff_lead {W : Submodule K (FMod K r n)} {m : Mon r n} :
    m ∈ inn W ↔ ∃ w ∈ W, ∃ hw : w ≠ 0, lead w hw = m := by
  simp only [mem_inn, isLead_iff_lead_eq]

/-- Vectors with distinct leading monomials are linearly independent. -/
theorem linearIndependent_of_isLead {ι : Type*} [Fintype ι] {w : ι → FMod K r n}
    {ℓ : ι → Mon r n} (hℓ : Function.Injective ℓ) (hw : ∀ i, IsLead (w i) (ℓ i)) :
    LinearIndependent K w := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  by_contra hne
  have hs : (univ.filter fun i => g i ≠ 0).Nonempty := by
    obtain ⟨i, hi⟩ := not_forall.mp hne; exact ⟨i, by simpa using hi⟩
  obtain ⟨i₀, hi₀, hmin⟩ := exists_min_image _ (fun i => lexFKey (ℓ i)) hs
  simp only [mem_filter, mem_univ, true_and] at hi₀ hmin
  have h := congrFun hg (ℓ i₀)
  rw [Finset.sum_apply, Finset.sum_eq_single i₀] at h
  · simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply, mul_eq_zero] at h
    rcases h with h | h
    · exact hi₀ h
    · exact (hw i₀).1 h
  · intro i _ hi
    simp only [Pi.smul_apply, smul_eq_mul]
    by_cases hgi : g i = 0
    · simp [hgi]
    · have : w i (ℓ i₀) = 0 := by
        by_contra hne'
        exact hi (hℓ (lexFKey_injective (le_antisymm ((hw i).key_le hne') (hmin i hgi))))
      simp [this]
  · simp

lemma card_inn_le_finrank (W : Submodule K (FMod K r n)) : #(inn W) ≤ finrank K W := by
  have hm : ∀ m : inn W, ∃ w ∈ W, IsLead w m := fun m => mem_inn.mp m.2
  choose w hwW hw using hm
  have hli : LinearIndependent K w := linearIndependent_of_isLead Subtype.val_injective hw
  have hli' : LinearIndependent K (fun m => (⟨w m, hwW m⟩ : W)) :=
    LinearIndependent.of_comp W.subtype hli
  simpa using hli'.fintype_card_le_finrank

lemma finrank_le_card_inn (W : Submodule K (FMod K r n)) : finrank K W ≤ #(inn W) := by
  let f : W →ₗ[K] (inn W → K) :=
    LinearMap.funLeft K K (Subtype.val : inn W → Mon r n) ∘ₗ W.subtype
  have hf : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra hne
    have hw0 : (w : FMod K r n) ≠ 0 := fun h => hne (Subtype.ext h)
    obtain ⟨m, hm⟩ := exists_isLead hw0
    exact hm.1 (congrFun hw ⟨m, mem_inn.mpr ⟨w, w.2, hm⟩⟩)
  have := LinearMap.finrank_le_finrank_of_injective hf
  rwa [Module.finrank_fintype_fun_eq_card, Fintype.card_coe] at this

/-- **Target 1** (first half of `lem-monomial`): `|in(W)| = dim W` for every subspace `W` of `F`. -/
theorem card_inn (W : Submodule K (FMod K r n)) : #(inn W) = finrank K W :=
  le_antisymm (card_inn_le_finrank W) (finrank_le_card_inn W)

end Lead

/-! ### Multiplication by `e_x`, `E₁V`, and the graded pieces -/

section Action
variable {K : Type*} [Field K] {r n : ℕ}

/-- The exterior sign `ε(x,σ) = (−1)^{#{y ∈ σ : y < x}}`, so that `e_x e_σ = ε(x,σ) e_{σ∪{x}}` for
`x ∉ σ`. -/
def extSign (x : Fin n) (σ : Finset (Fin n)) : K := (-1) ^ #(σ.filter (· < x))

lemma extSign_ne_zero (x : Fin n) (σ : Finset (Fin n)) : extSign (K := K) x σ ≠ 0 :=
  pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)

/-- Multiplication by `e_x` on `F`: `(e_x v)(i, τ) = ε(x, τ∖{x}) · v(i, τ∖{x})` if `x ∈ τ`, and `0`
otherwise. On basis vectors this is `e_x · e_σ gᵢ = ε(x,σ) e_{σ∪{x}} gᵢ` (`ex_single`). -/
def ex (x : Fin n) : FMod K r n →ₗ[K] FMod K r n where
  toFun v m := if x ∈ m.2 then extSign x (m.2.erase x) * v (m.1, m.2.erase x) else 0
  map_add' v w := by
    funext m; simp only [Pi.add_apply]; split_ifs <;> ring
  map_smul' c v := by
    funext m; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; split_ifs <;> ring

lemma ex_apply (x : Fin n) (v : FMod K r n) (m : Mon r n) :
    ex x v m = if x ∈ m.2 then extSign x (m.2.erase x) * v (m.1, m.2.erase x) else 0 := rfl

/-- `e_x · (e_σ gᵢ) = ε(x,σ) e_{σ∪{x}} gᵢ` if `x ∉ σ`, and `0` if `x ∈ σ`. -/
lemma ex_single (x : Fin n) (i : Fin r) (σ : Finset (Fin n)) :
    ex x (Pi.single (i, σ) 1 : FMod K r n) =
      if x ∈ σ then 0 else (extSign x σ : K) • Pi.single (i, insert x σ) 1 := by
  classical
  funext ⟨l, τ⟩
  rw [ex_apply]
  by_cases hσ : x ∈ σ
  · rw [ite_eq_left hσ, Pi.zero_apply]
    split_ifs with hτ
    · rw [Pi.single_apply, ite_eq_right, mul_zero]
      intro e
      simp only [Prod.mk.injEq] at e
      exact notMem_erase x τ (e.2 ▸ hσ)
    · rfl
  · rw [ite_eq_right hσ, Pi.smul_apply, smul_eq_mul, Pi.single_apply, Pi.single_apply]
    by_cases hτ : x ∈ τ
    · rw [ite_eq_left hτ]
      by_cases e : (l, τ.erase x) = (i, σ)
      · simp only [Prod.mk.injEq] at e
        obtain ⟨rfl, e⟩ := e
        have : τ = insert x σ := by rw [← e, insert_erase hτ]
        subst this
        simp [erase_insert hσ]
      · have e' : (l, τ) ≠ (i, insert x σ) := by
          intro h
          simp only [Prod.mk.injEq] at h
          exact e (by rw [h.1, h.2, erase_insert hσ])
        rw [ite_eq_right e, ite_eq_right e']
        simp
    · rw [ite_eq_right hτ, ite_eq_right, mul_zero]
      intro h
      simp only [Prod.mk.injEq] at h
      exact hτ (h.2 ▸ mem_insert_self x σ)

/-- Removing an element `z` of `s` changes `ε(x, s)` by the factor `−1` exactly when `z < x`. -/
lemma extSign_erase {x z : Fin n} {s : Finset (Fin n)} (hz : z ∈ s) :
    (extSign x s : K) = (if z < x then -1 else 1) * extSign x (s.erase z) := by
  unfold extSign
  rw [filter_erase]
  split_ifs with h
  · have hm : z ∈ s.filter (· < x) := mem_filter.mpr ⟨hz, h⟩
    obtain ⟨c, hc⟩ : ∃ c, #(s.filter (· < x)) = c + 1 :=
      ⟨#(s.filter (· < x)) - 1, by have := card_pos.mpr ⟨z, hm⟩; omega⟩
    rw [card_erase_of_mem hm, hc, Nat.add_sub_cancel, pow_succ]
    ring
  · have hm : z ∉ s.filter (· < x) := by simp [h]
    rw [erase_eq_of_notMem hm, one_mul]

/-- Sanity check of the model: `e_x e_x = 0`. -/
lemma ex_ex_self (x : Fin n) (v : FMod K r n) : ex x (ex x v) = 0 := by
  funext m
  rw [ex_apply, ex_apply]
  simp

/-- Sanity check of the model and of the sign `ε`: `e_x e_y = −e_y e_x` for `x ≠ y`. -/
lemma ex_comm {x y : Fin n} (hxy : x ≠ y) (v : FMod K r n) : ex x (ex y v) = -ex y (ex x v) := by
  funext ⟨i, τ⟩
  simp only [ex_apply, Pi.neg_apply, mem_erase, ne_eq]
  by_cases hx : x ∈ τ <;> by_cases hy : y ∈ τ <;> simp [hx, hy, hxy, Ne.symm hxy]
  rw [extSign_erase (x := x) (mem_erase.mpr ⟨Ne.symm hxy, hy⟩),
    extSign_erase (x := y) (mem_erase.mpr ⟨hxy, hx⟩), erase_right_comm]
  rcases lt_or_gt_of_ne hxy with h | h
  · simp only [h, not_lt_of_gt h, ↓reduceIte]; ring
  · simp only [h, not_lt_of_gt h, ↓reduceIte]; ring

/-- `E₁V`: the span of all `e_x v`, `v ∈ V`, `x ∈ [n]`. -/
def E1 (V : Submodule K (FMod K r n)) : Submodule K (FMod K r n) :=
  Submodule.span K {w | ∃ x, ∃ v ∈ V, ex x v = w}

lemma ex_mem_E1 {V : Submodule K (FMod K r n)} {v : FMod K r n} (hv : v ∈ V) (x : Fin n) :
    ex x v ∈ E1 V :=
  Submodule.subset_span ⟨x, v, hv, rfl⟩

lemma E1_le {V W : Submodule K (FMod K r n)} (h : ∀ x, ∀ v ∈ V, ex x v ∈ W) : E1 V ≤ W := by
  rw [E1, Submodule.span_le]
  rintro _ ⟨x, v, hv, rfl⟩
  exact h x v hv

variable (K n) in
/-- The graded piece `F_j = ⊕ᵢ E_{j−dᵢ} gᵢ` for generator degrees `d`: the vectors supported on
the monomials `e_σ gᵢ` with `#σ = j − dᵢ`. -/
def Fdeg (d : Fin r → ℤ) (j : ℤ) : Submodule K (FMod K r n) where
  carrier := {v | ∀ m, v m ≠ 0 → (#m.2 : ℤ) = j - d m.1}
  add_mem' {v w} hv hw m h := by
    by_cases hvm : v m = 0
    · exact hw m (by simpa [hvm] using h)
    · exact hv m hvm
  zero_mem' m h := absurd rfl h
  smul_mem' c v hv m h := hv m fun e => h (by simp [e])

lemma mem_Fdeg {d : Fin r → ℤ} {j : ℤ} {v : FMod K r n} :
    v ∈ Fdeg K n d j ↔ ∀ m, v m ≠ 0 → (#m.2 : ℤ) = j - d m.1 := Iff.rfl

/-- Multiplication by `e_x` maps `F_j` to `F_{j+1}`. -/
lemma ex_mem_Fdeg {d : Fin r → ℤ} {j : ℤ} {v : FMod K r n} (hv : v ∈ Fdeg K n d j) (x : Fin n) :
    ex x v ∈ Fdeg K n d (j + 1) := by
  intro m hm
  rw [ex_apply] at hm
  split_ifs at hm with hx
  · have h2 := hv _ (right_ne_zero_of_mul hm)
    have h3 := card_erase_add_one hx
    simp only at h2
    omega
  · exact absurd rfl hm

lemma E1_le_Fdeg {d : Fin r → ℤ} {j : ℤ} {V : Submodule K (FMod K r n)} (hV : V ≤ Fdeg K n d j) :
    E1 V ≤ Fdeg K n d (j + 1) :=
  E1_le fun x _ hv => ex_mem_Fdeg (hV hv) x

end Action

/-! ### Shadows in `F` and Lemma `lem-monomial` (target 2) -/

section Shadow
variable {K : Type*} [Field K] {r n : ℕ}

/-- Component `i` of a set of monomials: `𝒜 = ⊔ᵢ 𝒜ᵢ gᵢ`. -/
def comp (𝒜 : Finset (Mon r n)) (i : Fin r) : Finset (Finset (Fin n)) :=
  univ.filter fun σ => (i, σ) ∈ 𝒜

@[simp] lemma mem_comp {𝒜 : Finset (Mon r n)} {i : Fin r} {σ : Finset (Fin n)} :
    σ ∈ comp 𝒜 i ↔ (i, σ) ∈ 𝒜 := by
  simp [comp]

/-- The shadow `Shad 𝒜 = ⊔ᵢ (∇𝒜ᵢ) gᵢ` in `F`. -/
def Shad (𝒜 : Finset (Mon r n)) : Finset (Mon r n) := univ.filter fun m => m.2 ∈ ∂⁺ (comp 𝒜 m.1)

@[simp] lemma mem_Shad {𝒜 : Finset (Mon r n)} {m : Mon r n} :
    m ∈ Shad 𝒜 ↔ m.2 ∈ ∂⁺ (comp 𝒜 m.1) := by
  simp [Shad]

/-- `Shad 𝒜` is the set of non-zero `e_x m`, `m ∈ 𝒜`, up to sign. -/
lemma mem_Shad_iff {𝒜 : Finset (Mon r n)} {i : Fin r} {τ : Finset (Fin n)} :
    (i, τ) ∈ Shad 𝒜 ↔ ∃ σ, (i, σ) ∈ 𝒜 ∧ ∃ x ∉ σ, insert x σ = τ := by
  simp [mem_upShadow_iff]

lemma comp_Shad (𝒜 : Finset (Mon r n)) (i : Fin r) : comp (Shad 𝒜) i = ∂⁺ (comp 𝒜 i) := by
  ext σ; simp

lemma card_eq_sum_comp (𝒜 : Finset (Mon r n)) : #𝒜 = ∑ i, #(comp 𝒜 i) := by
  calc #𝒜 = #(univ.filter (· ∈ 𝒜)) := by congr 1; ext; simp
    _ = ∑ i, #(comp 𝒜 i) := by
      rw [card_filter, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [comp, card_filter]

/-- `|Shad 𝒜| = ∑ᵢ |∇𝒜ᵢ|`. -/
lemma card_Shad (𝒜 : Finset (Mon r n)) : #(Shad 𝒜) = ∑ i, #(∂⁺ (comp 𝒜 i)) := by
  rw [card_eq_sum_comp]; simp only [comp_Shad]

/-- `in(e_x v) = e_x in(v)` when `x ∉ in(v)`: multiplication by `e_x` is injective and
order-preserving on the monomials avoiding `x`, kills the others, and signs do not matter. -/
theorem isLead_ex {v : FMod K r n} {i : Fin r} {σ : Finset (Fin n)} (h : IsLead v (i, σ))
    {x : Fin n} (hx : x ∉ σ) : IsLead (ex x v) (i, insert x σ) := by
  refine ⟨?_, ?_⟩
  · rw [ex_apply, ite_eq_left (mem_insert_self x σ)]
    simp only [erase_insert hx]
    exact mul_ne_zero (extSign_ne_zero _ _) h.1
  · rintro ⟨l, τ⟩ hm hne
    rw [ex_apply] at hm
    split_ifs at hm with hxτ
    · have h1 : v (l, τ.erase x) ≠ 0 := right_ne_zero_of_mul hm
      by_cases e : (l, τ.erase x) = (i, σ)
      · exfalso; apply hne
        simp only [Prod.mk.injEq] at e ⊢
        exact ⟨e.1, by rw [← e.2, insert_erase hxτ]⟩
      · rcases h.2 _ h1 e with hlt | ⟨heq, hlex⟩
        · exact Or.inl hlt
        · refine Or.inr ⟨heq, ?_⟩
          have := lexLT_insert (τ := τ.erase x) hx hlex
          rwa [insert_erase hxτ] at this
    · exact absurd rfl hm

/-- `Shad(in V) ⊆ in(E₁V)`, for every subspace `V` of `F`. -/
theorem shad_inn_subset (V : Submodule K (FMod K r n)) : Shad (inn V) ⊆ inn (E1 V) := by
  rintro ⟨i, τ⟩ h
  obtain ⟨σ, hσ, x, hx, rfl⟩ := mem_Shad_iff.mp h
  obtain ⟨v, hv, hlead⟩ := mem_inn.mp hσ
  exact mem_inn.mpr ⟨ex x v, ex_mem_E1 hv x, isLead_ex hlead hx⟩

/-- **Lemma `lem-monomial`** (reduction to monomials, over any field). For every subspace `W` of
`F`, `|in(W)| = dim W`; and for every subspace `V`, `dim E₁V ≥ |Shad(in V)|`. -/
theorem lem_monomial :
    (∀ W : Submodule K (FMod K r n), #(inn W) = finrank K W) ∧
      ∀ V : Submodule K (FMod K r n), #(Shad (inn V)) ≤ finrank K (E1 V) :=
  ⟨card_inn, fun V => (card_le_card (shad_inn_subset V)).trans (card_inn _).le⟩

/-! #### Monomial subspaces: `E₁ · span 𝒜 = span (Shad 𝒜)`

The Setup's description of `Shad 𝒜` as "the set of monomials of `E₁·span 𝒜`": for monomial
subspaces `lem-monomial` is an equality. -/

variable (K) in
/-- `span 𝒜`, the monomial subspace spanned by a set `𝒜` of monomials: the vectors supported on `𝒜`
(`monoSpan_eq_span`). -/
def monoSpan (𝒜 : Finset (Mon r n)) : Submodule K (FMod K r n) where
  carrier := {v | ∀ m, v m ≠ 0 → m ∈ 𝒜}
  add_mem' {v w} hv hw m h := by
    by_cases hvm : v m = 0
    · exact hw m (by simpa [hvm] using h)
    · exact hv m hvm
  zero_mem' m h := absurd rfl h
  smul_mem' c v hv m h := hv m fun e => h (by simp [e])

lemma mem_monoSpan {𝒜 : Finset (Mon r n)} {v : FMod K r n} :
    v ∈ monoSpan K 𝒜 ↔ ∀ m, v m ≠ 0 → m ∈ 𝒜 := Iff.rfl

lemma single_mem_monoSpan {𝒜 : Finset (Mon r n)} {m : Mon r n} (hm : m ∈ 𝒜) :
    (Pi.single m 1 : FMod K r n) ∈ monoSpan K 𝒜 := by
  classical
  intro m' h'
  by_contra e
  have hne : m' ≠ m := fun h => e (h ▸ hm)
  exact h' (Pi.single_eq_of_ne hne 1)

/-- A basis vector `e_σ gᵢ` is its own leading monomial. -/
lemma isLead_single (m : Mon r n) : IsLead (Pi.single m (1 : K)) m := by
  classical
  refine ⟨by simp, fun m' h' hne => absurd (Pi.single_eq_of_ne hne 1) h'⟩

lemma inn_monoSpan (𝒜 : Finset (Mon r n)) : inn (monoSpan K 𝒜) = 𝒜 := by
  ext m
  rw [mem_inn]
  exact ⟨fun ⟨w, hw, hl⟩ => hw m hl.1, fun hm => ⟨_, single_mem_monoSpan hm, isLead_single m⟩⟩

lemma finrank_monoSpan (𝒜 : Finset (Mon r n)) : finrank K (monoSpan K 𝒜) = #𝒜 := by
  rw [← card_inn, inn_monoSpan]

/-- `monoSpan K 𝒜` is the span of the basis vectors `e_σ gᵢ`, `(i, σ) ∈ 𝒜`. -/
lemma monoSpan_eq_span (𝒜 : Finset (Mon r n)) :
    monoSpan K 𝒜 = Submodule.span K ((fun m => (Pi.single m 1 : FMod K r n)) '' ↑𝒜) := by
  symm
  apply Submodule.eq_of_le_of_finrank_le
  · rw [Submodule.span_le]
    rintro _ ⟨m, hm, rfl⟩
    exact single_mem_monoSpan hm
  · rw [finrank_monoSpan, ← card_inn]
    apply card_le_card
    intro m hm
    exact mem_inn.mpr ⟨_, Submodule.subset_span ⟨m, hm, rfl⟩, isLead_single m⟩

lemma E1_monoSpan_le (𝒜 : Finset (Mon r n)) : E1 (monoSpan K 𝒜) ≤ monoSpan K (Shad 𝒜) := by
  refine E1_le fun x v hv => ?_
  rintro ⟨i, τ⟩ h
  rw [ex_apply] at h
  split_ifs at h with hx
  · exact mem_Shad_iff.mpr
      ⟨τ.erase x, hv _ (right_ne_zero_of_mul h), x, notMem_erase x τ, insert_erase hx⟩
  · exact absurd rfl h

/-- `E₁ · span 𝒜 = span (Shad 𝒜)`: the monomials of `E₁·span 𝒜` are exactly `Shad 𝒜`. -/
theorem E1_monoSpan (𝒜 : Finset (Mon r n)) : E1 (monoSpan K 𝒜) = monoSpan K (Shad 𝒜) := by
  apply Submodule.eq_of_le_of_finrank_le (E1_monoSpan_le 𝒜)
  rw [finrank_monoSpan]
  have := lem_monomial.2 (monoSpan K 𝒜)
  rwa [inn_monoSpan] at this

/-- `dim E₁·span 𝒜 = |Shad 𝒜|`: equality in `lem-monomial` for monomial subspaces. -/
theorem finrank_E1_monoSpan (𝒜 : Finset (Mon r n)) :
    finrank K (E1 (monoSpan K 𝒜)) = #(Shad 𝒜) := by
  rw [E1_monoSpan, finrank_monoSpan]

end Shadow

/-! ### Theorem `thm-module-kk` for subspaces (target 3) -/

section ModuleKK
variable {K : Type*} [Field K] {r n : ℕ}

lemma forall₂_ofFn {α β : Type*} {R : α → β → Prop} {m : ℕ} {f : Fin m → α} {g : Fin m → β}
    (h : ∀ i, R (f i) (g i)) : List.Forall₂ R (List.ofFn f) (List.ofFn g) := by
  rw [List.forall₂_iff_get]
  refine ⟨by simp, fun i h₁ h₂ => ?_⟩
  simp only [List.get_eq_getElem, List.getElem_ofFn]
  exact h _

/-- The components of `in(V)` for `V ⊆ F_j` are families of `kᵢ`-sets, `kᵢ = j − dᵢ`. -/
lemma component_comp_inn {d : Fin r → ℤ} {j : ℤ} {V : Submodule K (FMod K r n)}
    (hV : V ≤ Fdeg K n d j) (i : Fin r) : Component (j - d i) (comp (inn V) i) := by
  have key : ∀ σ ∈ comp (inn V) i, (#σ : ℤ) = j - d i := by
    intro σ hσ
    obtain ⟨w, hw, hl⟩ := mem_inn.mp (mem_comp.mp hσ)
    exact hV hw _ hl.1
  refine ⟨fun σ hσ => ?_, fun hneg => ?_⟩
  · have := key σ hσ; omega
  · ext σ
    simp only [notMem_empty, iff_false]
    intro hσ
    have := key σ hσ; omega

/-- **Theorem `thm-module-kk`, the inequality, for subspaces.** Let `d₁ ≤ ⋯ ≤ d_r` and `V ⊆ F_j` a
subspace, `kᵢ = j − dᵢ`. Then `dim E₁V ≥ ∑ᵢ cᵢ(t*ᵢ)`, `t*` the greedy split of `dim V` with
capacities `C(n,kᵢ)` (`capZ`) and costs `cᵢ = σₙ(kᵢ,·)` (`costZ`). -/
theorem thm_module_kk_ineq (d : Fin r → ℤ) (hd : Monotone d) (j : ℤ)
    (V : Submodule K (FMod K r n)) (hV : V ≤ Fdeg K n d j) :
    cost (costZ n) (List.ofFn fun i => j - d i)
        (greedy (capZ n) (List.ofFn fun i => j - d i) (finrank K V)) ≤ finrank K (E1 V) := by
  have hks : (List.ofFn fun i => j - d i).Pairwise (· ≥ ·) := by
    rw [List.pairwise_ofFn]
    intro a b hab
    have := hd hab.le
    omega
  have hF : List.Forall₂ Component (List.ofFn fun i => j - d i)
      (List.ofFn fun i => comp (inn V) i) := forall₂_ofFn (component_comp_inn hV)
  have := module_shadow_ge_greedy _ hks _ hF
  rw [List.map_ofFn, List.sum_ofFn, List.map_ofFn, List.sum_ofFn] at this
  simp only [Function.comp_apply] at this
  rw [← card_eq_sum_comp, card_inn, ← card_Shad] at this
  exact this.trans (lem_monomial.2 V)

end ModuleKK

/-! ### `dim F_j` and Corollary `cor-prop41` (target 4) -/

section Hilbert
variable {K : Type*} [Field K] {r n : ℕ}

/-- The monomials of `F_j`: `Mon_j(F) = {e_σ gᵢ : #σ = j − dᵢ}`. -/
def monDeg (n : ℕ) (d : Fin r → ℤ) (j : ℤ) : Finset (Mon r n) :=
  univ.filter fun m => (#m.2 : ℤ) = j - d m.1

/-- `F_j` is the monomial subspace spanned by `Mon_j(F)`. -/
lemma Fdeg_eq_monoSpan (d : Fin r → ℤ) (j : ℤ) : Fdeg K n d j = monoSpan K (monDeg n d j) := by
  ext v
  simp [mem_Fdeg, mem_monoSpan, monDeg]

lemma inn_Fdeg (d : Fin r → ℤ) (j : ℤ) : inn (Fdeg K n d j) = monDeg n d j := by
  rw [Fdeg_eq_monoSpan, inn_monoSpan]

/-- `dim F_j = ∑ᵢ C(n, j − dᵢ)`, with `C(n,k) = 0` unless `0 ≤ k ≤ n`. -/
theorem finrank_Fdeg (d : Fin r → ℤ) (j : ℤ) :
    finrank K (Fdeg K n d j) = ∑ i, capZ n (j - d i) := by
  rw [← card_inn, inn_Fdeg, card_eq_sum_comp]
  refine Finset.sum_congr rfl fun i _ => ?_
  unfold capZ
  split_ifs with h
  · have : comp (monDeg n d j) i = powersetCard (j - d i).toNat univ := by
      ext σ; simp only [mem_comp, monDeg, mem_filter, mem_univ, true_and, mem_powersetCard,
        subset_univ]
      omega
    rw [this, card_powersetCard, card_univ, Fintype.card_fin]
  · have : comp (monDeg n d j) i = ∅ := by
      ext σ; simp only [mem_comp, monDeg, mem_filter, mem_univ, true_and, notMem_empty,
        iff_false]
      omega
    rw [this, card_empty]

/-- `dim F_j` is the total capacity `∑ᵢ Cᵢ` of the degree list `[j − d₁, …, j − d_r]`. -/
lemma finrank_Fdeg_eq_sum_capZ (d : Fin r → ℤ) (j : ℤ) :
    finrank K (Fdeg K n d j) = ((List.ofFn fun i => j - d i).map (capZ n)).sum := by
  rw [finrank_Fdeg, List.map_ofFn, List.sum_ofFn]; rfl

/-- **`cor-prop41`, local form.** If `V ⊆ F_j` and `E₁V ⊆ W`, then
`dim F_{j+1} − dim W ≤ dim F_{j+1} − ∑ᵢ cᵢ(t*ᵢ)`, `t*` the greedy split of `dim V`. -/
theorem cor_prop41_local (d : Fin r → ℤ) (hd : Monotone d) (j : ℤ)
    {V W : Submodule K (FMod K r n)} (hV : V ≤ Fdeg K n d j) (hVW : E1 V ≤ W) :
    finrank K (Fdeg K n d (j + 1)) - finrank K W ≤
      finrank K (Fdeg K n d (j + 1)) - cost (costZ n) (List.ofFn fun i => j - d i)
        (greedy (capZ n) (List.ofFn fun i => j - d i) (finrank K V)) := by
  have h1 := thm_module_kk_ineq d hd j V hV
  have h2 := Submodule.finrank_mono hVW
  omega

/-- **`cor-prop41`, graded-family form.** For subspaces `M_j ⊆ F_j` with `E₁M_j ⊆ M_{j+1}` (the
graded pieces of a graded submodule), `dim F_{j+1} − dim M_{j+1} ≤ dim F_{j+1} − ∑ᵢ cᵢ(t*ᵢ)`,
`t*` the greedy split of `dim M_j`. -/
theorem cor_prop41 (d : Fin r → ℤ) (hd : Monotone d) (M : ℤ → Submodule K (FMod K r n))
    (hM : ∀ j, M j ≤ Fdeg K n d j) (hE : ∀ j, E1 (M j) ≤ M (j + 1)) (j : ℤ) :
    finrank K (Fdeg K n d (j + 1)) - finrank K (M (j + 1)) ≤
      finrank K (Fdeg K n d (j + 1)) - cost (costZ n) (List.ofFn fun i => j - d i)
        (greedy (capZ n) (List.ofFn fun i => j - d i) (finrank K (M j))) :=
  cor_prop41_local d hd j (hM j) (hE j)

/-- The paper's `H_{F/M}(j) = dim F_j − dim M_j`, with `M_j = M ∩ F_j`. -/
noncomputable def hilbQ (d : Fin r → ℤ) (M : Submodule K (FMod K r n)) (j : ℤ) : ℕ :=
  finrank K (Fdeg K n d j) - finrank K ↥(M ⊓ Fdeg K n d j)

/-- **`cor-prop41`, submodule form.** For an `E`-submodule `M` of `F` (a subspace closed under
every `e_x`), `H_{F/M}(j+1) ≤ dim F_{j+1} − ∑ᵢ cᵢ(t*ᵢ)`, `t*` the greedy split of
`dim F_j − H_{F/M}(j) = dim M_j`; the right-hand side is the paper's `B(H_{F/M}(j), j)` once
`∑ᵢ cᵢ(t*ᵢ) = |Shad L|` (not proved here). Gradedness of `M` is not needed for the inequality. -/
theorem cor_prop41_submodule (d : Fin r → ℤ) (hd : Monotone d) (M : Submodule K (FMod K r n))
    (hM : ∀ x, ∀ v ∈ M, ex x v ∈ M) (j : ℤ) :
    hilbQ d M (j + 1) ≤
      finrank K (Fdeg K n d (j + 1)) - cost (costZ n) (List.ofFn fun i => j - d i)
        (greedy (capZ n) (List.ofFn fun i => j - d i)
          (finrank K (Fdeg K n d j) - hilbQ d M j)) := by
  have hle : finrank K ↥(M ⊓ Fdeg K n d j) ≤ finrank K (Fdeg K n d j) :=
    Submodule.finrank_mono inf_le_right
  have hsub : finrank K (Fdeg K n d j) - hilbQ d M j = finrank K ↥(M ⊓ Fdeg K n d j) := by
    unfold hilbQ; omega
  rw [hsub]
  exact cor_prop41_local d hd j inf_le_right
    (E1_le fun x v hv => ⟨hM x v hv.1, ex_mem_Fdeg hv.2 x⟩)

end Hilbert

end ModuleKK
end ExteriorConvex
