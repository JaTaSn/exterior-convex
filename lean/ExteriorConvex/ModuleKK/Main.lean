import Mathlib
import ExteriorConvex.ModuleKK.Macaulay
import ExteriorConvex.ModuleKK.LexF
import ExteriorConvex.ModuleKK.Subspace

open Finset Module
open scoped FinsetFamily

namespace ExteriorConvex
namespace ModuleKK

/-! ### Target 1: the printed growth bound `B` of `def-B` -/

section DefB

variable {n : ℕ}

/-- **Definition `def-B`, as printed**: `B(h,j) = T_ℓ(j+1) + a^{(k_ℓ)}`, with `ℓ`, `a`, `k_ℓ` as in
`def-B` (`ellB`, `remB`, `kB`) and the Macaulay operator `a^{(k)}` (`macaulayUp`, which equals the
printed definition read literally, `macaulayPrinted`, by `macaulayPrinted_eq`). The generator
degrees are the list `ds = [d₁, …, d_r]`; the model's `d : Fin r → ℤ` enters as `List.ofFn d`.
Meaningful for `0 ≤ h ≤ dim F_j`; for larger `h` it returns `dim F_{j+1}` (`ℓ = 0`). -/
def defB (n : ℕ) (ds : List ℤ) (h : ℕ) (j : ℤ) : ℕ := growthB macaulayUp n (extDeg ds j) h

/-- The printed Macaulay operator, read literally, gives the same `B`. -/
theorem defB_eq_macaulayPrinted (ds : List ℤ) (h : ℕ) (j : ℤ) :
    defB n ds h j = growthB macaulayPrinted n (extDeg ds j) h := by
  have e : macaulayPrinted = macaulayUp := funext fun k => funext fun a => macaulayPrinted_eq k a
  rw [defB, e]

/-- The shadow form of the Macaulay term agrees with `a^{(k)}` wherever `def-B` uses it
(`a < C(n,k)`): `thm-kk-rank1` "Moreover" for `k ≥ 1`, and `a = 0` for `k = 0`. -/
lemma macShadow_eq_macaulayUp {k a : ℕ} (ha : a < n.choose k) :
    macShadow n k a = macaulayUp k a := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · obtain rfl : a = 0 := by simpa using ha
    rw [macShadow_zero, macaulayUp_zero_right]
  · exact thm_kk_rank1_moreover n k a hk ha

/-- `Bω = B` for **every** `h`: inside the domain `h ≤ dim F_j` by `growthB_congr` and the
"Moreover" identity, outside it because both are `dim F_{j+1}` (`ℓ = 0`). -/
theorem Bω_eq_growthB_macaulayUp (ks : List ℤ) (h : ℕ) :
    Bω n ks h = growthB macaulayUp n ks h := by
  by_cases hh : h ≤ tailCap n ks 0
  · exact growthB_congr (fun _ _ ha => macShadow_eq_macaulayUp ha) hh
  · rw [Bω, growthB_of_le (by omega), growthB_of_le (by omega)]

/-- **Target 1.** The shadow-form growth bound of `LexF.lean` is the printed `B`. -/
theorem Bωj_eq_defB (ds : List ℤ) (h : ℕ) (j : ℤ) : Bωj n ds h j = defB n ds h j :=
  Bω_eq_growthB_macaulayUp _ _

lemma Bωj_eq_defB' (ds : List ℤ) : Bωj n ds = defB n ds :=
  funext fun h => funext fun j => Bωj_eq_defB ds h j

end DefB

/-! ### Bridges between the list encoding and the model -/

section ListLemmas

variable {r : ℕ}

lemma getD_ofFn {α : Type*} (f : Fin r → α) (i : ℕ) (a : α) :
    (List.ofFn f).getD i a = if h : i < r then f ⟨i, h⟩ else a := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_ofFn]
  split_ifs <;> rfl

lemma getD_ofFn_lt {α : Type*} (f : Fin r → α) {i : ℕ} (hi : i < r) (a : α) :
    (List.ofFn f).getD i a = f ⟨i, hi⟩ := by
  rw [getD_ofFn]; simp [hi]

@[simp] lemma getD_ofFn_fin {α : Type*} (f : Fin r → α) (i : Fin r) (a : α) :
    (List.ofFn f).getD i a = f i :=
  getD_ofFn_lt f i.2 a

lemma forall₂_ofFn_iff {α β : Type*} {R : α → β → Prop} {f : Fin r → α} {g : Fin r → β} :
    List.Forall₂ R (List.ofFn f) (List.ofFn g) ↔ ∀ i, R (f i) (g i) := by
  refine ⟨fun h i => ?_, forall₂_ofFn⟩
  have := h.get (i := i.1) (by simp) (by simp)
  simpa using this

lemma eq_ofFn_getD {α : Type*} {l : List α} (hl : l.length = r) (a : α) :
    l = List.ofFn fun i : Fin r => l.getD i a := by
  apply List.ext_getElem (by simp [hl])
  intro i h1 h2
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h1]

lemma forall₂_getD {α β : Type*} {R : α → β → Prop} {l₁ : List α} {l₂ : List β}
    (h : List.Forall₂ R l₁ l₂) {i : ℕ} (hi : i < l₁.length) (a : α) (b : β) :
    R (l₁.getD i a) (l₂.getD i b) := by
  have hl := h.length_eq
  have := h.get hi (hl ▸ hi)
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi,
    List.getElem?_eq_getElem (hl ▸ hi)]
  simpa using this

lemma count_ofFn {α : Type*} [DecidableEq α] : ∀ {r : ℕ} (f : Fin r → α) (c : α),
    (List.ofFn f).count c = #(univ.filter fun i => f i = c)
  | 0, f, c => by simp
  | r + 1, f, c => by
    rw [List.ofFn_succ, List.count_cons, count_ofFn (fun i => f i.succ) c, card_filter,
      card_filter, Fin.sum_univ_succ]
    simp only [beq_iff_eq]
    omega

end ListLemmas

section Bridge

variable {r n : ℕ}

lemma extDeg_ofFn (d : Fin r → ℤ) (j : ℤ) :
    extDeg (List.ofFn d) j = List.ofFn fun i => j - d i := by
  rw [extDeg, List.map_ofFn]; rfl

lemma pairwise_ofFn_of_monotone {d : Fin r → ℤ} (hd : Monotone d) :
    (List.ofFn d).Pairwise (· ≤ ·) :=
  List.pairwise_ofFn.mpr fun _ _ hij => hd hij.le

/-- `dim F_j` in the model is `dimF` of `LexF.lean` for `ds = List.ofFn d`. -/
lemma finrank_Fdeg_eq_dimF {K : Type*} [Field K] (d : Fin r → ℤ) (j : ℤ) :
    finrank K (Fdeg K n d j) = dimF n (List.ofFn d) j := by
  rw [finrank_Fdeg_eq_sum_capZ, dimF, tailCap_zero, extDeg_ofFn]

lemma mem_monDeg {d : Fin r → ℤ} {j : ℤ} {m : Mon r n} :
    m ∈ monDeg n d j ↔ (#m.2 : ℤ) = j - d m.1 := by
  simp [monDeg]

/-- `|Mon_j(F)| = dim F_j`. -/
lemma card_monDeg (d : Fin r → ℤ) (j : ℤ) : #(monDeg n d j) = dimF n (List.ofFn d) j := by
  rw [← finrank_Fdeg_eq_dimF (K := ℚ), ← card_inn, inn_Fdeg]

/-- The components `[𝒜₁, …, 𝒜_r]` of a set `𝒜` of monomials of `F`, as the list used in
`LexF.lean`. -/
def toFam (𝒜 : Finset (Mon r n)) : List (Finset (Finset (Fin n))) := List.ofFn (comp 𝒜)

/-- The set of monomials `⊔ᵢ 𝒜ᵢ gᵢ` whose components are the entries of a list. -/
def ofFam (𝒜s : List (Finset (Finset (Fin n)))) : Finset (Mon r n) :=
  univ.filter fun m => m.2 ∈ 𝒜s.getD m.1 ∅

@[simp] lemma mem_ofFam {𝒜s : List (Finset (Finset (Fin n)))} {m : Mon r n} :
    m ∈ ofFam 𝒜s ↔ m.2 ∈ 𝒜s.getD m.1 ∅ := by
  simp [ofFam]

lemma comp_ofFam (𝒜s : List (Finset (Finset (Fin n)))) (i : Fin r) :
    comp (ofFam (r := r) 𝒜s) i = 𝒜s.getD i ∅ := by
  ext σ; simp

lemma length_toFam (𝒜 : Finset (Mon r n)) : (toFam 𝒜).length = r := List.length_ofFn

lemma ofFam_toFam (𝒜 : Finset (Mon r n)) : ofFam (toFam 𝒜) = 𝒜 := by
  ext ⟨i, σ⟩
  simp [toFam]

lemma toFam_ofFam {𝒜s : List (Finset (Finset (Fin n)))} (h : 𝒜s.length = r) :
    toFam (ofFam (r := r) 𝒜s) = 𝒜s := by
  rw [toFam]
  conv_rhs => rw [eq_ofFn_getD h ∅]
  congr 1
  funext i
  exact comp_ofFam 𝒜s i

lemma card_eq_sum_toFam (𝒜 : Finset (Mon r n)) : #𝒜 = ((toFam 𝒜).map card).sum := by
  rw [card_eq_sum_comp, toFam, List.map_ofFn, List.sum_ofFn]; rfl

lemma card_Shad_eq_sum_toFam (𝒜 : Finset (Mon r n)) :
    #(Shad 𝒜) = ((toFam 𝒜).map fun ℬ => #(∂⁺ ℬ)).sum := by
  rw [card_Shad, toFam, List.map_ofFn, List.sum_ofFn]; rfl

lemma toFam_Shad (𝒜 : Finset (Mon r n)) : toFam (Shad 𝒜) = (toFam 𝒜).map upShadow := by
  rw [toFam, toFam, List.map_ofFn]
  congr 1
  funext i
  exact comp_Shad 𝒜 i

lemma component_iff {k : ℤ} {𝒜 : Finset (Finset (Fin n))} :
    Component k 𝒜 ↔ ∀ σ ∈ 𝒜, (#σ : ℤ) = k := by
  constructor
  · rintro ⟨h1, h2⟩ σ hσ
    by_cases hk : k < 0
    · rw [h2 hk] at hσ; simp at hσ
    · have := h1 (mem_coe.mpr hσ); omega
  · intro h
    refine ⟨fun σ hσ => ?_, fun hk => ?_⟩
    · have := h σ (mem_coe.mp hσ); omega
    · ext σ
      simp only [notMem_empty, iff_false]
      intro hσ
      have := h σ hσ; omega

/-- `𝒜 ⊆ Mon_j(F)` iff its components form a monomial family of `F_j` in the sense of
`LexF.lean`. -/
lemma subset_monDeg_iff {d : Fin r → ℤ} {j : ℤ} {𝒜 : Finset (Mon r n)} :
    𝒜 ⊆ monDeg n d j ↔ List.Forall₂ Component (extDeg (List.ofFn d) j) (toFam 𝒜) := by
  rw [extDeg_ofFn, toFam, forall₂_ofFn_iff]
  simp only [component_iff, mem_comp]
  constructor
  · intro h i σ hσ
    exact mem_monDeg.mp (h hσ)
  · rintro h ⟨i, σ⟩ hm
    exact mem_monDeg.mpr (h i σ hm)

lemma subset_iff_comp {𝒜 ℬ : Finset (Mon r n)} : 𝒜 ⊆ ℬ ↔ ∀ i, comp 𝒜 i ⊆ comp ℬ i := by
  constructor
  · intro h i σ hσ
    exact mem_comp.mpr (h (mem_comp.mp hσ))
  · rintro h ⟨i, σ⟩ hm
    exact mem_comp.mp (h i (mem_comp.mpr hm))

end Bridge

/-! ### lexF segments in the model -/

section LexFModel

variable {r n : ℕ}

/-- **`lexF` segment** of `Mon_j(F)` in the model (§`sec-lex`, the paper's definition): a subset
`L ⊆ Mon_j(F)` that is an initial segment for `>_lexF` (`LexFGT`, position over term). -/
def IsLexFSegF (n : ℕ) (d : Fin r → ℤ) (j : ℤ) (L : Finset (Mon r n)) : Prop :=
  L ⊆ monDeg n d j ∧ ∀ ⦃m m' : Mon r n⦄, m ∈ L → m' ∈ monDeg n d j → LexFGT m' m → m' ∈ L

/-- The model's lexF segments are `LexF.lean`'s order-theoretic ones (`IsLexFInitial`). -/
theorem isLexFSegF_iff_initial {d : Fin r → ℤ} {j : ℤ} {L : Finset (Mon r n)} :
    IsLexFSegF n d j L ↔ IsLexFInitial n (extDeg (List.ofFn d) j) (toFam L) := by
  constructor
  · rintro ⟨hsub, hinit⟩
    refine ⟨subset_monDeg_iff.mp hsub, ?_⟩
    intro i l u v hv hi h0 hu hlt
    rw [extDeg_ofFn, List.length_ofFn] at hi
    rw [extDeg_ofFn, getD_ofFn_lt _ hi] at h0 hu
    rw [toFam, getD_ofFn] at hv
    rw [toFam, getD_ofFn_lt _ hi]
    split_ifs at hv with hl
    · rw [mem_comp] at hv ⊢
      refine hinit hv (mem_monDeg.mpr (by simp only; omega)) ?_
      rcases hlt with hlt | ⟨rfl, hlex⟩
      · exact Or.inl (Fin.mk_lt_mk.mpr hlt)
      · exact Or.inr ⟨rfl, hlex⟩
    · simp at hv
  · rintro ⟨hc, hinit⟩
    refine ⟨subset_monDeg_iff.mpr hc, ?_⟩
    rintro ⟨l, v⟩ ⟨i, u⟩ hm hm' hgt
    have hu : (#u : ℤ) = j - d i := mem_monDeg.mp hm'
    have key := @hinit i l u v
      (by rw [toFam, getD_ofFn_fin]; exact mem_comp.mpr hm)
      (by rw [extDeg_ofFn, List.length_ofFn]; exact i.2)
      (by rw [extDeg_ofFn, getD_ofFn_fin]; omega)
      (by rw [extDeg_ofFn, getD_ofFn_fin]; omega)
      (by
        rcases hgt with h | ⟨h1, h2⟩
        · exact Or.inl h
        · exact Or.inr ⟨congrArg Fin.val h1, h2⟩)
    rw [toFam, getD_ofFn_fin] at key
    exact mem_comp.mp key

/-- The model's lexF segments are `LexF.lean`'s `IsLexFSeg` (greedy component sizes, lex-initial
components). -/
theorem isLexFSegF_iff {d : Fin r → ℤ} {j : ℤ} {L : Finset (Mon r n)} :
    IsLexFSegF n d j L ↔ IsLexFSeg n (extDeg (List.ofFn d) j) #L (toFam L) := by
  rw [isLexFSegF_iff_initial, isLexFInitial_iff, ← card_eq_sum_toFam]

/-- Existence: `Mon_j(F)` has a lexF segment of every size `t ≤ dim F_j`. -/
theorem exists_isLexFSegF (n : ℕ) (d : Fin r → ℤ) (j : ℤ) {t : ℕ}
    (ht : t ≤ dimF n (List.ofFn d) j) : ∃ L : Finset (Mon r n), IsLexFSegF n d j L ∧ #L = t := by
  have ht' : t ≤ tailCap n (extDeg (List.ofFn d) j) 0 := ht
  obtain ⟨𝒜s, h𝒜⟩ := exists_isLexFSeg n (extDeg (List.ofFn d) j) t
  have hlen : 𝒜s.length = r := by
    rw [← h𝒜.1.length_eq, extDeg_ofFn, List.length_ofFn]
  have hsum := h𝒜.card_sum
  have hcard : #(ofFam (r := r) 𝒜s) = t := by
    rw [card_eq_sum_toFam, toFam_ofFam hlen, hsum]
    exact min_eq_left ht'
  refine ⟨ofFam 𝒜s, ?_, hcard⟩
  rw [isLexFSegF_iff, toFam_ofFam hlen, hcard]
  have := h𝒜.resize
  rwa [hsum, min_eq_left ht'] at this

/-- Uniqueness: a lexF segment of `Mon_j(F)` is determined by its size. -/
theorem isLexFSegF_unique {d : Fin r → ℤ} {j : ℤ} {L L' : Finset (Mon r n)}
    (hL : IsLexFSegF n d j L) (hL' : IsLexFSegF n d j L') (hc : #L = #L') : L = L' := by
  rw [isLexFSegF_iff] at hL hL'
  have e := isLexFSeg_unique' hL hL' (by rw [← card_eq_sum_toFam, ← card_eq_sum_toFam, hc])
  rw [← ofFam_toFam L, ← ofFam_toFam L', e]

/-- `|Shad L| = ∑ᵢ cᵢ(t*ᵢ)` for a lexF segment `L` of `Mon_j(F)`. -/
lemma IsLexFSegF.card_Shad {d : Fin r → ℤ} {j : ℤ} {L : Finset (Mon r n)}
    (hL : IsLexFSegF n d j L) :
    #(Shad L) = cost (costZ n) (extDeg (List.ofFn d) j)
      (greedy (capZ n) (extDeg (List.ofFn d) j) #L) := by
  rw [card_Shad_eq_sum_toFam]
  exact (isLexFSegF_iff.mp hL).shadow_sum

/-- **Lemma `lem-lexF-shadow` in the model**: the shadow of a lexF segment of `Mon_j(F)` is a lexF
segment of `Mon_{j+1}(F)`. -/
theorem IsLexFSegF.shad {d : Fin r → ℤ} (hd : Monotone d) {j : ℤ} {L : Finset (Mon r n)}
    (hL : IsLexFSegF n d j L) : IsLexFSegF n d (j + 1) (Shad L) := by
  have h := lem_lexF_shadow (extDeg_pairwise (pairwise_ofFn_of_monotone hd) j)
    (isLexFSegF_iff.mp hL)
  rw [← extDeg_succ, ← toFam_Shad] at h
  rw [isLexFSegF_iff, card_eq_sum_toFam]
  exact h.resize

end LexFModel

/-! ### Target 2: Theorem `thm-module-kk` -/

section ModuleKKThm

variable {K : Type*} [Field K] {r n : ℕ}

/-- **Theorem `thm-module-kk`** (Module Kruskal–Katona), in the model over any field `K`: for
`d₁ ≤ ⋯ ≤ d_r`, a subspace `V ⊆ F_j` and the lexF segment `L` of `Mon_j(F)` with `|L| = dim V`,
`dim E₁V ≥ |Shad L|` and `dim F_{j+1} − |Shad L| = B(dim F_j − dim V, j)`, `B` the printed
growth bound. (`L` exists and is unique: `thm_module_kk_existsUnique`.) -/
theorem thm_module_kk (d : Fin r → ℤ) (hd : Monotone d) (j : ℤ) (V : Submodule K (FMod K r n))
    (hV : V ≤ Fdeg K n d j) {L : Finset (Mon r n)} (hL : IsLexFSegF n d j L)
    (hLV : #L = finrank K V) :
    #(Shad L) ≤ finrank K (E1 V) ∧
      finrank K (Fdeg K n d (j + 1)) - #(Shad L) =
        defB n (List.ofFn d) (finrank K (Fdeg K n d j) - finrank K V) j := by
  have hks := extDeg_pairwise (pairwise_ofFn_of_monotone hd) j
  refine ⟨?_, ?_⟩
  · rw [hL.card_Shad, hLV, extDeg_ofFn]
    exact thm_module_kk_ineq d hd j V hV
  · have h := thm_module_kk_formula hks (isLexFSegF_iff.mp hL)
    rw [← card_eq_sum_toFam, ← card_Shad_eq_sum_toFam, ← extDeg_succ, hLV] at h
    rw [finrank_Fdeg_eq_dimF, finrank_Fdeg_eq_dimF, defB, ← Bω_eq_growthB_macaulayUp]
    exact h

/-- The lexF segment of `thm-module-kk` exists and is unique. -/
theorem thm_module_kk_existsUnique (d : Fin r → ℤ) (j : ℤ) (V : Submodule K (FMod K r n))
    (hV : V ≤ Fdeg K n d j) : ∃! L : Finset (Mon r n), IsLexFSegF n d j L ∧ #L = finrank K V := by
  obtain ⟨L, hL, hc⟩ := exists_isLexFSegF n d j (t := finrank K V)
    (by rw [← finrank_Fdeg_eq_dimF (K := K)]; exact Submodule.finrank_mono hV)
  exact ⟨L, ⟨hL, hc⟩, fun L' ⟨hL', hc'⟩ => isLexFSegF_unique hL' hL (by rw [hc, hc'])⟩

end ModuleKKThm

/-! ### Submodules of the model: `E`-stability, gradedness, monomial submodules, generation -/

section Submodules

variable {K : Type*} [Field K] {r n : ℕ}

/-- `M` is an **`E`-submodule** of `F`: a `K`-subspace closed under multiplication by every `e_x`
(`E` is generated by the `e_x` as a `K`-algebra, so this is closure under `E`). -/
def IsESub (M : Submodule K (FMod K r n)) : Prop := ∀ x, ∀ v ∈ M, ex x v ∈ M

/-- The homogeneous component of degree `j` of `v ∈ F` (generator degrees `d`): `v` restricted to
the monomials `e_σ gᵢ` of degree `dᵢ + #σ = j`. -/
def gproj (d : Fin r → ℤ) (j : ℤ) (v : FMod K r n) : FMod K r n :=
  fun m => if (#m.2 : ℤ) = j - d m.1 then v m else 0

/-- `M` is **graded**, `M = ⊕ⱼ (M ∩ F_j)`: closed under taking homogeneous components. -/
def IsGradedF (d : Fin r → ℤ) (M : Submodule K (FMod K r n)) : Prop :=
  ∀ v ∈ M, ∀ j, gproj d j v ∈ M

lemma isESub_iff_E1_le {M : Submodule K (FMod K r n)} : IsESub M ↔ E1 M ≤ M :=
  ⟨fun h => E1_le h, fun h x _ hv => h (ex_mem_E1 hv x)⟩

lemma monoSpan_mono {𝒜 ℬ : Finset (Mon r n)} (h : 𝒜 ⊆ ℬ) : monoSpan K 𝒜 ≤ monoSpan K ℬ :=
  fun _ hv m hm => h (hv m hm)

lemma monoSpan_le_iff {𝒜 ℬ : Finset (Mon r n)} : monoSpan K 𝒜 ≤ monoSpan K ℬ ↔ 𝒜 ⊆ ℬ := by
  classical
  refine ⟨fun h m hm => ?_, monoSpan_mono⟩
  exact h (single_mem_monoSpan (K := K) hm) m (by simp)

/-- A monomial subspace is an `E`-submodule iff its set of monomials is closed under `Shad`. -/
lemma isESub_monoSpan_iff {𝒜 : Finset (Mon r n)} : IsESub (monoSpan K 𝒜) ↔ Shad 𝒜 ⊆ 𝒜 := by
  rw [isESub_iff_E1_le, E1_monoSpan, monoSpan_le_iff]

/-- A monomial subspace is graded. -/
lemma isGradedF_monoSpan (d : Fin r → ℤ) (𝒜 : Finset (Mon r n)) :
    IsGradedF d (monoSpan K 𝒜) := by
  intro v hv j m hm
  unfold gproj at hm
  split_ifs at hm
  · exact hv m hm
  · exact absurd rfl hm

lemma monoSpan_inf (𝒜 ℬ : Finset (Mon r n)) :
    monoSpan K 𝒜 ⊓ monoSpan K ℬ = monoSpan K (𝒜 ∩ ℬ) := by
  ext v
  simp only [Submodule.mem_inf, mem_monoSpan, mem_inter]
  exact ⟨fun ⟨h1, h2⟩ m hm => ⟨h1 m hm, h2 m hm⟩,
    fun h => ⟨fun m hm => (h m hm).1, fun m hm => (h m hm).2⟩⟩

/-- `H_{F/span 𝒜}(j) = dim F_j − |𝒜 ∩ Mon_j(F)|`. -/
lemma hilbQ_monoSpan (d : Fin r → ℤ) (𝒜 : Finset (Mon r n)) (j : ℤ) :
    hilbQ d (monoSpan K 𝒜) j = finrank K (Fdeg K n d j) - #(𝒜 ∩ monDeg n d j) := by
  unfold hilbQ
  congr 1
  rw [Fdeg_eq_monoSpan (K := K) d j, monoSpan_inf, finrank_monoSpan]

/-- The `E`-submodule of `F` **generated** by a set `S` of vectors: the smallest `E`-stable
subspace containing `S`. -/
def Egen (S : Set (FMod K r n)) : Submodule K (FMod K r n) := sInf {N | S ⊆ N ∧ IsESub N}

lemma subset_Egen (S : Set (FMod K r n)) : S ⊆ Egen S := by
  intro v hv
  rw [SetLike.mem_coe, Egen, Submodule.mem_sInf]
  exact fun N hN => hN.1 hv

lemma Egen_isESub (S : Set (FMod K r n)) : IsESub (Egen S) := by
  intro x v hv
  rw [Egen, Submodule.mem_sInf] at hv ⊢
  exact fun N hN => hN.2 x v (hv N hN)

lemma Egen_le {S : Set (FMod K r n)} {N : Submodule K (FMod K r n)} (hS : S ⊆ N)
    (hN : IsESub N) : Egen S ≤ N :=
  sInf_le ⟨hS, hN⟩

variable (K) in
/-- The monomials of a set `𝒜 ⊆ Mon(F)`, as vectors (basis vectors `e_σ gᵢ`). -/
def monoVecs (𝒜 : Finset (Mon r n)) : Set (FMod K r n) := (fun m => Pi.single m 1) '' ↑𝒜

/-- The monomials divisible by a monomial of `𝒜`: `{e_τ gᵢ : e_σ gᵢ ∈ 𝒜, σ ⊆ τ}`. -/
def upClos (𝒜 : Finset (Mon r n)) : Finset (Mon r n) :=
  univ.filter fun m => ∃ σ, (m.1, σ) ∈ 𝒜 ∧ σ ⊆ m.2

lemma mem_upClos {𝒜 : Finset (Mon r n)} {i : Fin r} {τ : Finset (Fin n)} :
    (i, τ) ∈ upClos 𝒜 ↔ ∃ σ, (i, σ) ∈ 𝒜 ∧ σ ⊆ τ := by
  simp [upClos]

lemma subset_upClos (𝒜 : Finset (Mon r n)) : 𝒜 ⊆ upClos 𝒜 := by
  rintro ⟨i, σ⟩ hm
  exact mem_upClos.mpr ⟨σ, hm, subset_rfl⟩

lemma Shad_upClos_subset (𝒜 : Finset (Mon r n)) : Shad (upClos 𝒜) ⊆ upClos 𝒜 := by
  rintro ⟨i, τ⟩ h
  obtain ⟨σ, hσ, x, -, rfl⟩ := mem_Shad_iff.mp h
  obtain ⟨ρ, hρ, hρσ⟩ := mem_upClos.mp hσ
  exact mem_upClos.mpr ⟨ρ, hρ, hρσ.trans (subset_insert x σ)⟩

/-- An `E`-submodule containing the basis vector `e_σ gᵢ` contains every `e_τ gᵢ` with `σ ⊆ τ`. -/
lemma single_mem_of_subset {N : Submodule K (FMod K r n)} (hN : IsESub N) {i : Fin r}
    {σ τ : Finset (Fin n)} (hσ : (Pi.single (i, σ) 1 : FMod K r n) ∈ N) (hστ : σ ⊆ τ) :
    (Pi.single (i, τ) 1 : FMod K r n) ∈ N := by
  classical
  have key : ∀ s : Finset (Fin n), Disjoint s σ → (Pi.single (i, σ ∪ s) 1 : FMod K r n) ∈ N := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro _; simpa using hσ
    | insert a s ha ih =>
      intro hdis
      rw [disjoint_insert_left] at hdis
      have h1 := ih hdis.2
      have haσs : a ∉ σ ∪ s := by
        rw [mem_union, not_or]; exact ⟨hdis.1, ha⟩
      have h2 := hN a _ h1
      simp only [ex_single, haσs, ↓reduceIte] at h2
      have h3 := N.smul_mem (extSign (K := K) a (σ ∪ s))⁻¹ h2
      rw [smul_smul, inv_mul_cancel₀ (extSign_ne_zero _ _), one_smul] at h3
      rwa [union_insert]
  have := key (τ \ σ) sdiff_disjoint
  rwa [union_sdiff_of_subset hστ] at this

/-- The `E`-submodule generated by the monomials of `𝒜` is the monomial subspace spanned by the
monomials divisible by them. -/
theorem Egen_monoVecs (𝒜 : Finset (Mon r n)) :
    Egen (monoVecs K 𝒜) = monoSpan K (upClos 𝒜) := by
  apply le_antisymm
  · apply Egen_le
    · rintro _ ⟨m, hm, rfl⟩
      exact single_mem_monoSpan (subset_upClos 𝒜 hm)
    · exact isESub_monoSpan_iff.mpr (Shad_upClos_subset 𝒜)
  · rw [monoSpan_eq_span, Submodule.span_le]
    rintro _ ⟨⟨i, τ⟩, hm, rfl⟩
    obtain ⟨σ, hσ, hστ⟩ := mem_upClos.mp hm
    exact single_mem_of_subset (Egen_isESub _) (subset_Egen _ ⟨(i, σ), hσ, rfl⟩) hστ

/-- For `L ⊆ Mon_j(F)`: the degree-`j` monomials divisible by `L` are `L`. -/
lemma upClos_inter_monDeg {d : Fin r → ℤ} {j : ℤ} {L : Finset (Mon r n)}
    (hL : L ⊆ monDeg n d j) : upClos L ∩ monDeg n d j = L := by
  ext ⟨i, τ⟩
  rw [mem_inter, mem_upClos]
  constructor
  · rintro ⟨⟨σ, hσ, hστ⟩, hτ⟩
    have hσd := mem_monDeg.mp (hL hσ)
    have hτd := mem_monDeg.mp hτ
    have e : σ = τ := eq_of_subset_of_card_le hστ (by simp only at hσd hτd; omega)
    rwa [← e]
  · intro h
    exact ⟨⟨τ, h, subset_rfl⟩, hL h⟩

/-- For `L ⊆ Mon_j(F)`: the degree-`(j+1)` monomials divisible by `L` are `Shad L`. -/
lemma upClos_inter_monDeg_succ {d : Fin r → ℤ} {j : ℤ} {L : Finset (Mon r n)}
    (hL : L ⊆ monDeg n d j) : upClos L ∩ monDeg n d (j + 1) = Shad L := by
  classical
  ext ⟨i, τ⟩
  rw [mem_inter, mem_upClos, mem_Shad_iff]
  constructor
  · rintro ⟨⟨σ, hσ, hστ⟩, hτ⟩
    have hσd := mem_monDeg.mp (hL hσ)
    have hτd := mem_monDeg.mp hτ
    obtain ⟨x, hx, e⟩ := exists_eq_insert_iff.mpr ⟨hστ, by simp only at hσd hτd; omega⟩
    exact ⟨σ, hσ, x, hx, e⟩
  · rintro ⟨σ, hσ, x, hx, rfl⟩
    have hσd := mem_monDeg.mp (hL hσ)
    refine ⟨⟨σ, hσ, subset_insert x σ⟩, mem_monDeg.mpr ?_⟩
    simp only at hσd ⊢
    rw [card_insert_of_notMem hx]
    push_cast
    omega

/-- Two sets of monomials with the same graded pieces are equal. -/
lemma eq_of_inter_monDeg {d : Fin r → ℤ} {𝒜 ℬ : Finset (Mon r n)}
    (h : ∀ j, 𝒜 ∩ monDeg n d j = ℬ ∩ monDeg n d j) : 𝒜 = ℬ := by
  ext m
  have hm : m ∈ monDeg n d (d m.1 + #m.2) := mem_monDeg.mpr (by ring)
  have := Finset.ext_iff.mp (h (d m.1 + #m.2)) m
  simpa only [mem_inter, hm, and_true] using this

end Submodules

/-! ### Target 3: Corollary `cor-prop41` -/

section CorProp41

variable {K : Type*} [Field K] {r n : ℕ}

/-- The numerical identity behind `cor-prop41`: `dim F_{j+1} − ∑ᵢ cᵢ(t*ᵢ) = B(dim F_j − t, j)` for
`t ≤ dim F_j` (`cost_greedy_add_Bω` and `Bωj_eq_defB`). -/
lemma dimF_sub_cost_eq_defB (d : Fin r → ℤ) (hd : Monotone d) (j : ℤ) {t : ℕ}
    (ht : t ≤ dimF n (List.ofFn d) j) :
    dimF n (List.ofFn d) (j + 1) - cost (costZ n) (extDeg (List.ofFn d) j)
        (greedy (capZ n) (extDeg (List.ofFn d) j) t) =
      defB n (List.ofFn d) (dimF n (List.ofFn d) j - t) j := by
  have key := cost_greedy_add_Bω (n := n) (extDeg (List.ofFn d) j)
    (extDeg_pairwise (pairwise_ofFn_of_monotone hd) j) t ht
  rw [← extDeg_succ, Bω_eq_growthB_macaulayUp] at key
  unfold dimF defB
  omega

/-- **Corollary `cor-prop41`, inequality, graded-family form**: subspaces `M_j ⊆ F_j` with
`E₁M_j ⊆ M_{j+1}` (the graded pieces of a graded submodule) satisfy
`dim F_{j+1} − dim M_{j+1} ≤ B(dim F_j − dim M_j, j)`, with the printed `B`. -/
theorem cor_prop41_family_B (d : Fin r → ℤ) (hd : Monotone d) (M : ℤ → Submodule K (FMod K r n))
    (hM : ∀ j, M j ≤ Fdeg K n d j) (hE : ∀ j, E1 (M j) ≤ M (j + 1)) (j : ℤ) :
    finrank K (Fdeg K n d (j + 1)) - finrank K (M (j + 1)) ≤
      defB n (List.ofFn d) (finrank K (Fdeg K n d j) - finrank K (M j)) j := by
  have h1 := cor_prop41 d hd M hM hE j
  have ht : finrank K (M j) ≤ dimF n (List.ofFn d) j := by
    rw [← finrank_Fdeg_eq_dimF (K := K)]; exact Submodule.finrank_mono (hM j)
  have h2 := dimF_sub_cost_eq_defB (n := n) d hd j ht
  rw [← finrank_Fdeg_eq_dimF (K := K) d (j + 1), ← finrank_Fdeg_eq_dimF (K := K) d j,
    extDeg_ofFn] at h2
  rw [← h2]
  exact h1

/-- **Corollary `cor-prop41`, inequality**: for every `E`-submodule `M ⊆ F` (graded or not; the
paper's graded submodules are a special case) and every `j ∈ ℤ`,
`H_{F/M}(j+1) ≤ B(H_{F/M}(j), j)`, with `H_{F/M}(j) = dim F_j − dim (M ∩ F_j)` (`hilbQ`) and the
printed `B`. -/
theorem cor_prop41_B (d : Fin r → ℤ) (hd : Monotone d) (M : Submodule K (FMod K r n))
    (hM : IsESub M) (j : ℤ) :
    hilbQ d M (j + 1) ≤ defB n (List.ofFn d) (hilbQ d M j) j := by
  have h1 := cor_prop41_submodule d hd M hM j
  have hle : hilbQ d M j ≤ finrank K (Fdeg K n d j) := Nat.sub_le _ _
  have ht : finrank K (Fdeg K n d j) - hilbQ d M j ≤ dimF n (List.ofFn d) j := by
    rw [← finrank_Fdeg_eq_dimF (K := K)]; exact Nat.sub_le _ _
  have h2 := dimF_sub_cost_eq_defB (n := n) d hd j ht
  rw [← finrank_Fdeg_eq_dimF (K := K) d (j + 1), ← finrank_Fdeg_eq_dimF (K := K) d j,
    Nat.sub_sub_self hle, extDeg_ofFn] at h2
  rw [← h2]
  exact h1

/-- **Corollary `cor-prop41`, equality clause**: for a lexF segment `L` of `Mon_j(F)`, the
submodule `N = Egen (monoVecs K L)` generated by `L` is a graded `E`-submodule with
`H_{F/N}(j) = dim F_j − |L|` and `H_{F/N}(j+1) = B(H_{F/N}(j), j)`: equality in `cor-prop41` at
`j`. -/
theorem cor_prop41_eq (d : Fin r → ℤ) (hd : Monotone d) (j : ℤ) {L : Finset (Mon r n)}
    (hL : IsLexFSegF n d j L) :
    IsESub (Egen (monoVecs K L)) ∧ IsGradedF d (Egen (monoVecs K L)) ∧
      hilbQ d (Egen (monoVecs K L)) j = finrank K (Fdeg K n d j) - #L ∧
      hilbQ d (Egen (monoVecs K L)) (j + 1) =
        defB n (List.ofFn d) (hilbQ d (Egen (monoVecs K L)) j) j := by
  have hN := Egen_monoVecs (K := K) L
  have hNj : hilbQ d (Egen (monoVecs K L)) j = finrank K (Fdeg K n d j) - #L := by
    rw [hN, hilbQ_monoSpan, upClos_inter_monDeg hL.1]
  refine ⟨Egen_isESub _, hN ▸ isGradedF_monoSpan d _, hNj, ?_⟩
  have hV : monoSpan K L ≤ Fdeg K n d j := by
    rw [Fdeg_eq_monoSpan]; exact monoSpan_mono hL.1
  have hmk := (thm_module_kk d hd j (monoSpan K L) hV hL (finrank_monoSpan L).symm).2
  rw [hNj, hN, hilbQ_monoSpan, upClos_inter_monDeg_succ hL.1, hmk, finrank_monoSpan]

/-- **Corollary `cor-prop41`, in full**: for every `E`-submodule `M ⊆ F` and every `j ∈ ℤ`,
`H_{F/M}(j+1) ≤ B(H_{F/M}(j), j)`; and for the lexF segment `L` of size `dim M_j` (which exists),
the submodule `N` generated by `L` has `H_{F/N}(j) = H_{F/M}(j)` and
`H_{F/N}(j+1) = B(H_{F/M}(j), j)`, i.e. it attains the bound. -/
theorem cor_prop41_full (d : Fin r → ℤ) (hd : Monotone d) (M : Submodule K (FMod K r n))
    (hM : IsESub M) (j : ℤ) :
    hilbQ d M (j + 1) ≤ defB n (List.ofFn d) (hilbQ d M j) j ∧
      ∃ L : Finset (Mon r n), IsLexFSegF n d j L ∧ #L = finrank K ↥(M ⊓ Fdeg K n d j) ∧
        hilbQ d (Egen (monoVecs K L)) j = hilbQ d M j ∧
        hilbQ d (Egen (monoVecs K L)) (j + 1) = defB n (List.ofFn d) (hilbQ d M j) j := by
  refine ⟨cor_prop41_B d hd M hM j, ?_⟩
  obtain ⟨L, hL, hc⟩ := exists_isLexFSegF n d j (t := finrank K ↥(M ⊓ Fdeg K n d j))
    (by rw [← finrank_Fdeg_eq_dimF (K := K)]; exact Submodule.finrank_mono inf_le_right)
  obtain ⟨-, -, h1, h2⟩ := cor_prop41_eq (K := K) d hd j hL
  have e : hilbQ d (Egen (monoVecs K L)) j = hilbQ d M j := by rw [h1, hc]; rfl
  exact ⟨L, hL, hc, e, by rw [h2, e]⟩

end CorProp41

/-! ### Target 4: Theorem `thm-ac42` -/

section AC42

variable {r n : ℕ}

/-- A **lex submodule** in the model (§`sec-lex`), given by its set `𝓛` of monomials: the
monomial subspace `monoSpan K 𝓛` is an `E`-submodule (`Shad 𝓛 ⊆ 𝓛`; `isESub_monoSpan_iff`)
all of whose graded pieces `𝓛 ∩ Mon_j(F)` are lexF segments. -/
def IsLexSet (n : ℕ) (d : Fin r → ℤ) (𝓛 : Finset (Mon r n)) : Prop :=
  Shad 𝓛 ⊆ 𝓛 ∧ ∀ j, IsLexFSegF n d j (𝓛 ∩ monDeg n d j)

/-- The set of monomials with graded pieces `G j`. -/
def glue (d : Fin r → ℤ) (G : ℤ → Finset (Mon r n)) : Finset (Mon r n) :=
  univ.filter fun m => m ∈ G (d m.1 + #m.2)

lemma glue_inter {d : Fin r → ℤ} {G : ℤ → Finset (Mon r n)} (hG : ∀ j, G j ⊆ monDeg n d j)
    (j : ℤ) : glue d G ∩ monDeg n d j = G j := by
  ext m
  simp only [glue, mem_inter, mem_filter, mem_univ, true_and]
  constructor
  · rintro ⟨h, hm⟩
    have := mem_monDeg.mp hm
    rwa [show d m.1 + #m.2 = j by omega] at h
  · intro h
    have := mem_monDeg.mp (hG j h)
    exact ⟨by rwa [show d m.1 + #m.2 = j by omega], hG j h⟩

lemma Shad_glue_subset {d : Fin r → ℤ} {G : ℤ → Finset (Mon r n)}
    (hS : ∀ j, Shad (G j) ⊆ G (j + 1)) : Shad (glue d G) ⊆ glue d G := by
  rintro ⟨i, τ⟩ h
  obtain ⟨σ, hσ, x, hx, rfl⟩ := mem_Shad_iff.mp h
  simp only [glue, mem_filter, mem_univ, true_and] at hσ ⊢
  have h1 := hS _ (mem_Shad_iff.mpr ⟨σ, hσ, x, hx, rfl⟩)
  rwa [card_insert_of_notMem hx, Nat.cast_add, Nat.cast_one, ← add_assoc]

variable {K : Type*} [Field K]

/-- The span of a lex set is an `E`-submodule (it is graded by `isGradedF_monoSpan`). -/
lemma IsLexSet.isESub {d : Fin r → ℤ} {𝓛 : Finset (Mon r n)} (h : IsLexSet n d 𝓛) :
    IsESub (monoSpan K 𝓛) :=
  isESub_monoSpan_iff.mpr h.1

/-- `thm-ac42`, (2) ⇒ (3), in the model, with the printed `B`. -/
theorem thm_ac42_two_three_F (d : Fin r → ℤ) (hd : Monotone d) {d₁ dr : ℤ} (h : ℤ → ℕ)
    (hsupp : ∀ j, j < d₁ ∨ dr + n < j → h j = 0)
    (hB : ∀ j, d₁ - 1 ≤ j → j ≤ dr + n - 1 → h (j + 1) ≤ defB n (List.ofFn d) (h j) j) :
    ∃ 𝓛 : Finset (Mon r n), IsLexSet n d 𝓛 ∧ ∀ j, hilbQ d (monoSpan K 𝓛) j = h j := by
  obtain ⟨L, hL, hLh⟩ := thm_ac42_two_three (n := n) (pairwise_ofFn_of_monotone hd) h hsupp
    (by simpa only [Bωj_eq_defB] using hB)
  have hlen : ∀ j, (L j).length = r := fun j => by
    rw [← (hL.1.comp j).length_eq, extDeg_ofFn, List.length_ofFn]
  have hGt : ∀ j, toFam (ofFam (r := r) (L j)) = L j := fun j => toFam_ofFam (hlen j)
  have hG : ∀ j, ofFam (r := r) (L j) ⊆ monDeg n d j := fun j =>
    subset_monDeg_iff.mpr (by rw [hGt]; exact hL.1.comp j)
  have hS : ∀ j, Shad (ofFam (r := r) (L j)) ⊆ ofFam (L (j + 1)) := by
    intro j
    rw [subset_iff_comp]
    intro i
    rw [comp_Shad, comp_ofFam, comp_ofFam]
    exact forall₂_getD (hL.1.shad j) (by rw [hlen]; exact i.2) ∅ ∅
  refine ⟨glue d fun j => ofFam (L j), ⟨Shad_glue_subset hS, fun j => ?_⟩, fun j => ?_⟩
  · rw [glue_inter hG, isLexFSegF_iff_initial, hGt, isLexFInitial_iff_exists]
    exact hL.2 j
  · rw [hilbQ_monoSpan, glue_inter hG, card_eq_sum_toFam, hGt, finrank_Fdeg_eq_dimF]
    exact hLh j

/-- **Theorem `thm-ac42`, uniqueness**: a lex submodule of the model is determined by its
quotient Hilbert function. -/
theorem thm_ac42_lex_unique (d : Fin r → ℤ) {𝓛 𝓛' : Finset (Mon r n)} (h𝓛 : IsLexSet n d 𝓛)
    (h𝓛' : IsLexSet n d 𝓛')
    (hh : ∀ j, hilbQ d (monoSpan K 𝓛) j = hilbQ d (monoSpan K 𝓛') j) : 𝓛 = 𝓛' := by
  apply eq_of_inter_monDeg (d := d)
  intro j
  have h1 := hh j
  rw [hilbQ_monoSpan, hilbQ_monoSpan, finrank_Fdeg_eq_dimF, ← card_monDeg] at h1
  have c1 := card_le_card (inter_subset_right (s₁ := 𝓛) (s₂ := monDeg n d j))
  have c2 := card_le_card (inter_subset_right (s₁ := 𝓛') (s₂ := monDeg n d j))
  exact isLexFSegF_unique (h𝓛.2 j) (h𝓛'.2 j) (by omega)

/-- **Theorem `thm-ac42`** (Amata–Crupi Theorem 4.2), in the model over any field `K`. Let
`d₁ ≤ ⋯ ≤ d_r` (`r ≥ 1`) and `h : ℤ → ℕ` with `h_j = 0` outside `[d₁, d_r + n]`. Equivalent:
1. `h = H_{F/M}` for a graded `E`-submodule `M ⊆ F`;
2. `h_{j+1} ≤ B(h_j, j)` for every `j ∈ [d₁ − 1, d_r + n − 1]`, with the printed `B`;
3. `h = H_{F/L}` for a lex submodule `L = span 𝓛 ⊆ F`.
The lex submodule is unique (`thm_ac42_lex_unique`). -/
theorem thm_ac42 (K : Type*) [Field K] (d : Fin r → ℤ) (hd : Monotone d) (hr : 0 < r)
    (h : ℤ → ℕ) (hsupp : ∀ j, j < d ⟨0, hr⟩ ∨ d ⟨r - 1, by omega⟩ + n < j → h j = 0) :
    List.TFAE
      [∃ M : Submodule K (FMod K r n), IsESub M ∧ IsGradedF d M ∧ ∀ j, hilbQ d M j = h j,
       ∀ j, d ⟨0, hr⟩ - 1 ≤ j → j ≤ d ⟨r - 1, by omega⟩ + n - 1 →
         h (j + 1) ≤ defB n (List.ofFn d) (h j) j,
       ∃ 𝓛 : Finset (Mon r n), IsLexSet n d 𝓛 ∧ ∀ j, hilbQ d (monoSpan K 𝓛) j = h j] := by
  tfae_have 1 → 2 := by
    rintro ⟨M, hM, -, hMh⟩ j _ _
    have := cor_prop41_B d hd M hM j
    rwa [hMh, hMh] at this
  tfae_have 2 → 3 := thm_ac42_two_three_F d hd h hsupp
  tfae_have 3 → 1 := fun ⟨𝓛, h𝓛, h𝓛h⟩ =>
    ⟨monoSpan K 𝓛, h𝓛.isESub, isGradedF_monoSpan d 𝓛, h𝓛h⟩
  tfae_finish

/-- `thm-ac42`, (2) ⇒ (3) with uniqueness: under condition (2) there is exactly one lex submodule
with quotient Hilbert function `h`. -/
theorem thm_ac42_existsUnique (K : Type*) [Field K] (d : Fin r → ℤ) (hd : Monotone d) {d₁ dr : ℤ}
    (h : ℤ → ℕ) (hsupp : ∀ j, j < d₁ ∨ dr + n < j → h j = 0)
    (hB : ∀ j, d₁ - 1 ≤ j → j ≤ dr + n - 1 → h (j + 1) ≤ defB n (List.ofFn d) (h j) j) :
    ∃! 𝓛 : Finset (Mon r n), IsLexSet n d 𝓛 ∧ ∀ j, hilbQ d (monoSpan K 𝓛) j = h j := by
  obtain ⟨𝓛, h𝓛, h𝓛h⟩ := thm_ac42_two_three_F (K := K) d hd h hsupp hB
  exact ⟨𝓛, ⟨h𝓛, h𝓛h⟩, fun 𝓛' ⟨h𝓛', h𝓛'h⟩ =>
    thm_ac42_lex_unique (K := K) d h𝓛' h𝓛 fun j => by rw [h𝓛h, h𝓛'h]⟩

/-- `thm-ac42` with condition (1) relaxed: the equivalence also holds with "some `E`-submodule
`M ⊆ F`, graded or not" in (1) (with `H_{F/M}(j) = dim F_j − dim (M ∩ F_j)`). -/
theorem thm_ac42_ungraded (K : Type*) [Field K] (d : Fin r → ℤ) (hd : Monotone d) (hr : 0 < r)
    (h : ℤ → ℕ) (hsupp : ∀ j, j < d ⟨0, hr⟩ ∨ d ⟨r - 1, by omega⟩ + n < j → h j = 0) :
    (∃ M : Submodule K (FMod K r n), IsESub M ∧ ∀ j, hilbQ d M j = h j) ↔
      ∃ M : Submodule K (FMod K r n), IsESub M ∧ IsGradedF d M ∧ ∀ j, hilbQ d M j = h j := by
  refine ⟨fun ⟨M, hM, hMh⟩ => ?_, fun ⟨M, hM, _, hMh⟩ => ⟨M, hM, hMh⟩⟩
  have h2 : ∀ j, d ⟨0, hr⟩ - 1 ≤ j → j ≤ d ⟨r - 1, by omega⟩ + n - 1 →
      h (j + 1) ≤ defB n (List.ofFn d) (h j) j := by
    intro j _ _
    have := cor_prop41_B d hd M hM j
    rwa [hMh, hMh] at this
  obtain ⟨𝓛, h𝓛, h𝓛h⟩ := thm_ac42_two_three_F (K := K) d hd h hsupp h2
  exact ⟨monoSpan K 𝓛, h𝓛.isESub, isGradedF_monoSpan d 𝓛, h𝓛h⟩

end AC42

/-! ### Target 5: Corollary `cor-initial`, with the printed `B` -/

section Initial

variable {r n : ℕ}

/-- **Corollary `cor-initial`** with the printed `B`: with `r̃₀ = #{i : dᵢ = j₀}` and
`r̃₁ = #{i : dᵢ = j₀ + 1}`, `B(0, j₀ − 1) = r̃₀`, and `B(h, j₀) = n·h + r̃₁` for `1 ≤ h ≤ r̃₀`
(for every `j₀ ∈ ℤ`; the paper takes `j₀` the initial degree of a Hilbert function). -/
theorem cor_initial_B (d : Fin r → ℤ) (hd : Monotone d) (j₀ : ℤ) :
    defB n (List.ofFn d) 0 (j₀ - 1) = #(univ.filter fun i => d i = j₀) ∧
      ∀ h, 1 ≤ h → h ≤ #(univ.filter fun i => d i = j₀) →
        defB n (List.ofFn d) h j₀ = n * h + #(univ.filter fun i => d i = j₀ + 1) := by
  have := cor_initial_growthB (n := n) (M := macaulayUp) macaulayUp_zero_right
    (pairwise_ofFn_of_monotone hd) j₀
  simpa only [count_ofFn, defB] using this

/-- **Corollary `cor-initial`**, last sentence, with the printed `B`: if `h ≢ 0` and
`j₀ = min {j : h_j ≠ 0}`, the instances `j = j₀ − 1` and `j = j₀` of condition (2) of `thm-ac42`
are `h_{j₀} ≤ r̃₀` and (given that) `h_{j₀+1} ≤ n·h_{j₀} + r̃₁`. -/
theorem cor_initial_instances_B (d : Fin r → ℤ) (hd : Monotone d) (h : ℤ → ℕ) (j₀ : ℤ)
    (hj₀ : h j₀ ≠ 0) (hmin : ∀ j < j₀, h j = 0) :
    (h j₀ ≤ defB n (List.ofFn d) (h (j₀ - 1)) (j₀ - 1) ↔
        h j₀ ≤ #(univ.filter fun i => d i = j₀)) ∧
      (h j₀ ≤ #(univ.filter fun i => d i = j₀) →
        (h (j₀ + 1) ≤ defB n (List.ofFn d) (h j₀) j₀ ↔
          h (j₀ + 1) ≤ n * h j₀ + #(univ.filter fun i => d i = j₀ + 1))) := by
  have := cor_initial_instances (n := n) (pairwise_ofFn_of_monotone hd) h j₀
    (hmin _ (by omega)) (Nat.one_le_iff_ne_zero.mpr hj₀)
  simpa only [Bωj_eq_defB, count_ofFn] using this

end Initial

