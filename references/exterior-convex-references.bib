@article{NilssonSnellman2003,
  author     = {Nilsson, Andreas and Snellman, Jan},
  title      = {Lifting {G}r{\"o}bner bases from the exterior algebra},
  journal    = {Communications in Algebra},
  volume     = {31},
  number     = {12},
  pages      = {5715--5725},
  year       = {2003},
  issn       = {0092-7872,1532-4125},
  doi        = {10.1081/AGB-120024850},
  url        = {https://doi.org/10.1081/AGB-120024850},
  mrnumber   = {2014899},
  mrclass    = {16S10},
  mrreviewer = {Ene, Viviana},
  note    = {MathSciNet review received 2026-08-07: MR2014899 (2004i:16034), reviewed by
             Viviana Ene; 1 citation recorded (From References: 1, From Reviews: 0). NOTE a
             preprint/published discrepancy found by comparing the review's reference list
             against the local arXiv v2 PDF: the published version cites \emph{nine} works,
             the preprint only eight -- Pardue's 1994 Brandeis thesis (\texttt{Pardue1994},
             added to this file from the same review) appears only in the published version.
             Anyone quoting this paper's bibliography should therefore use the published
             list, not the local preprint's. MathSciNet also records the authors' affiliations
             as S-RIT (Royal Institute of Technology) and S-STOC (Stockholm University),
             which differ from the arXiv preprint's own title page (Tokyo and Link\"oping
             respectively) -- presumably a 2000-vs-2003 difference, not an error.
             Jan's own paper; not duplicated here -- PDF already at the top level,
             \texttt{publications/published/math\_0010117\_lifting-grobner-bases-from-the-exterior-algebra.pdf},
             tracked in the top-level \texttt{PUBLISHED-ARTICLES.md}. Extends
             Eisenbud--Peeva--Sturmfels's non-commutative Gr\"obner basis results (ideals
             containing the commutator ideal, i.e.\ lifting from the symmetric algebra)
             to the anti-commutator ideal (lifting from the exterior algebra) -- genuinely
             needed because the naive lift of a generating set is not automatically a
             Gr\"obner basis in the noncommutative free algebra (a "squeezing" correction
             is required, their Theorem 2.1); discussed 2026-08-07 re: whether this or the
             elementary commutative $I+J$ trick is the right tool for Gr\"obner bases of
             the "artinified" modules in skoldberg-indicator-module.org -- conclusion: the
             elementary trick suffices there, since $\mathfrak S(V_n)$ is commutative; this
             paper's heavier machinery would be needed only for computations directly in
             $E$ itself. Open question flagged by Jan (2026-08-07, see TODO.md's "Other open
             threads"): does this paper's lift-plus-squeeze construction, stated there only
             for ideals (rank 1), extend to submodules of free modules of rank $r>1$? Not
             investigated.}
}

